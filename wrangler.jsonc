{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igs",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry (wraps the default TanStack Start handler to add security headers)
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "indogermanschool.com/*",
      "zone_name": "indogermanschool.com",
    },
    {
      "pattern": "www.indogermanschool.com/*",
      "zone_name": "indogermanschool.com",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://indogermanschool.com",
    "R2_ACCOUNT_ID": "83d4d6746ea272718c8c962ecf89a8cb",
    "R2_BUCKET_NAME": "igs",
    "RESEND_FROM_EMAIL": "IGS <mail@mohankumar.dev>",
    "CONTACT_NOTIFICATION_EMAIL": "mail@mohankumar.dev",
    // Poster QR code (/wa): WhatsApp redirect target and the GA4 property
    // that counts scans. The GA4 API secret is a secret, not a var:
    // wrangler secret put GA4_API_SECRET
    "WA_URL": "https://wa.me/918050718044?text=Hi%2C%20I%27d%20like%20to%20know%20about%20Playgroup%20admissions%20at%20IGS",
    "GA4_MEASUREMENT_ID": "G-LQB8L3SEEV",
  },
}
